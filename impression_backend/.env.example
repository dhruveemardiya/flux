# Django Secret Key
SECRET_KEY=replace-with-your-django-secret-key

# Debug Mode (True for development, False for production)
DEBUG=False

# Allowed Hosts (comma-separate
ALLOWED_HOSTS=localhost,127.0.0.1

# Primary MySQL Database Configuration
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# Remote Tally Database Configuration (optional / secondary)
TALLY_DB_NAME=your_tally_database
TALLY_DB_USER=your_tally_user
TALLY_DB_PASSWORD=your_tally_password
TALLY_DB_HOST=your_tally_host
TALLY_DB_PORT=3306
